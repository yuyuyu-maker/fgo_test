# --- Conda / Isaac runtimes ---
**/thirdparty/miniconda3/
**/_isaac_sim/
**/.env_setup_finish
**/.env_setup_finished
*.bak

# IsaacLab: ignore checked-out thirdparty *contents* but keep submodule gitlinks
# (gitlinks are mode 160000; do not `git rm --cached` those two paths)
isaaclab_experiments/thirdparty/**
!isaaclab_experiments/thirdparty/IsaacLab
!isaaclab_experiments/thirdparty/whole_body_tracking

# WBT reference: keep download script + README, ignore downloaded payloads
isaaclab_experiments/whole_body_tracking_reference_data/**
!isaaclab_experiments/whole_body_tracking_reference_data/*.py
!isaaclab_experiments/whole_body_tracking_reference_data/*.md
!isaaclab_experiments/whole_body_tracking_reference_data/README.md

# Go2 deploy: local SDK clones (have their own .git; install via scripts/setup_unitree_sdk2.sh)
go2_deploy/thirdparty/cyclonedds/
go2_deploy/thirdparty/unitree_sdk2_python/
go2_deploy/.venv*/
go2_deploy/thirdparty/unitree_rl_lab/

# Manipulation: heavy local installs / forks
manipulation_experiments/thirdparty/miniconda3/
manipulation_experiments/thirdparty/dexmimicgen/
manipulation_experiments/far-wandb/
manipulation_experiments/threading_teaser/
manipulation_experiments/tmp_tobe_removed/

# RM75: drop recorded packs & official mesh dump (URDF wrapper stays)
rm75_sim/assets/RM75-6FB/
rm75_sim/assets/**/*.STL
rm75_sim/assets/**/*.stl

# --- Misc local noise ---
nohup.out
*.log
*.out
pids.txt
**/pids.txt
**/stamp.txt
core
core.*
