# =============================================================================
# fgo_test: keep source / docs / scripts; ignore bulky / local / binary artifacts
# =============================================================================

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.egg
.ipynb_checkpoints/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.venv/
venv/
.env
.env.*
!.env.example

# --- Claude / agent local ---
.claude/

# --- Experiment outputs (train / eval / sweeps) ---
**/logs/
**/outputs/
